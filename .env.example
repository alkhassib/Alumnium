# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# Required: your OpenAI API key (used by Alumnium).
OPENAI_API_KEY=sk-your-key-here

# Optional overrides (defaults shown in conftest.py):
# ALUMNIUM_MODEL=openai
# ALUMNIUM_LOG_LEVEL=debug
# ALUMNIUM_CACHE=filesystem

# Set to 1/true to run the browser headless (e.g. on CI). Default: headed.
# HEADLESS=1
